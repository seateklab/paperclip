# Copy this file to docker/.env.production and fill in the secrets before starting.
#
# Command:
#   cp docker/.env.production.example docker/.env.production
#   docker compose -f docker/docker-compose.production.yml --env-file docker/.env.production up -d --build
#
# This example is a single-node production stack with the app + PostgreSQL.
# For cloud or multi-node production, switch DATABASE_URL to a managed PostgreSQL
# endpoint and keep the other runtime settings unchanged.

# Public deployment mode
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=public
PAPERCLIP_PUBLIC_URL=https://paperclip.example.com

# Optional extra hostnames that should be accepted by the authenticated server.
# Use this for LAN/Tailscale/proxy aliases if required.
PAPERCLIP_ALLOWED_HOSTNAMES=

# First-admin bootstrap control
PAPERCLIP_BOOTSTRAP_ADMIN_EMAIL=

# Server runtime
HOST=0.0.0.0
PORT=3100
NODE_ENV=production
SERVE_UI=true
PAPERCLIP_BIND_IP=127.0.0.1
PAPERCLIP_PORT=3100
PAPERCLIP_HOME=/paperclip
PAPERCLIP_INSTANCE_ID=default
PAPERCLIP_CONFIG=/paperclip/instances/default/config.json
PAPERCLIP_MIGRATION_AUTO_APPLY=true
HEARTBEAT_SCHEDULER_ENABLED=true

# Secrets
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
PAPERCLIP_SECRETS_STRICT_MODE=true
PAPERCLIP_SECRETS_MASTER_KEY_FILE=/paperclip/secrets/master.key

# Database
POSTGRES_USER=paperclip
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=paperclip
# If you change POSTGRES_PASSWORD, update both DATABASE_* URLs below to match.
DATABASE_URL=postgres://paperclip:replace-with-a-strong-database-password@db:5432/paperclip
DATABASE_MIGRATION_URL=postgres://paperclip:replace-with-a-strong-database-password@db:5432/paperclip

# Optional adapter credentials. Leave blank unless you actually need local CLI adapters
# inside the container.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GITHUB_TOKEN=

# Optional host-level user remap for bind-mounted volumes. Leave at defaults unless
# you know you need to match a non-root host ownership model.
USER_UID=1000
USER_GID=1000
