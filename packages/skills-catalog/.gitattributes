# Enforce LF line endings for catalog source files.
# The generated manifest (generated/catalog.json) stores sha256 hashes
# computed over LF-normalized bytes. Git's core.autocrlf=true on Windows
# converts files to CRLF on checkout, which breaks hash verification at
# install time. This .gitattributes forces LF for catalog text files so
# the working-tree bytes match the manifest hashes.

* text=auto eol=lf

*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.svg  text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.ts   text eol=lf
*.css  text eol=lf
*.txt  text eol=lf

# Binary files - no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
